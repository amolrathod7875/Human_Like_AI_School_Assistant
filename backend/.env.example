# Service identity
PROJECT_NAME=xyz-ai-backend
SERVICE_NAME=xyz-ai-backend
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated origins, or ["*"] to allow all (development only)
BACKEND_CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO

# Request identity
REQUEST_ID_HEADER=X-Request-ID
