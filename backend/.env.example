# Service identity
PROJECT_NAME=xyz-ai-backend
SERVICE_NAME=xyz-ai-backend
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# CORS - comma-separated origins, or ["*"] to allow all (development only)
BACKEND_CORS_ORIGINS=["*"]

# Logging
LOG_LEVEL=INFO

# Request identity
REQUEST_ID_HEADER=X-Request-ID

# Firebase Authentication (service-account credentials, never hardcoded)
# Provide these via environment / secret manager. DO NOT commit real values.
# The private key may contain escaped newlines (\n) — they are normalized at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cohere LLM provider (secret API key; provide via env / secret manager, never commit)
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
COHERE_TIMEOUT=30
COHERE_MAX_RETRIES=1

# AI orchestrator (tuning only, no secrets)
AI_CONTEXT_MESSAGE_LIMIT=10
AI_MAX_TOOL_CALLS=3
